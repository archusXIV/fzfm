#!/usr/bin/env bash
#
# Author: Barret E (2026) <https://github.com/archusXIV/fzfm>
# Script name: fzfm version 0.2.13
# License: GPLv2
#
# A simple terminal file manager using fzf, with expected functionalities
# - copy/paste, move, rename, create, edit, delete files
# - bookmarks support
# - Navigate directories with fzf selection previews update dynamically.
# - Dependencies: bat, ueberzugpp and tree for previews and programs determined in ~/.config/fzfm/fzfmrc
# - Press Ctrl-C or ESC in fzf to exit.

# shellcheck disable=SC2154
# shellcheck source=/dev/null
# Needed if your shell isn't bash,
# this will set the bash shell only in this terminal session.
export SHELL="/bin/bash"
shopt -s checkwinsize

version="0.2.13"
script_name=$(basename "$0")
config_dir="$HOME/.config/fzfm"
config="$config_dir/fzfmrc"
ascii_file="$config_dir/fzfm_ascii"
book_marks="$config_dir/fzfm_bookmarks"
themerc="$config_dir/themerc"

# shell syntax for prompts
red=$'\e[31m'
grn=$'\e[32m'
ylw=$'\e[33m'
cyn=$'\e[36m'
noc=$'\e[0m'
bold=$'\e[1m'
nobold=$'\e[21m'

if [[ -f $config && -f $themerc ]]; then
    source "$config"
    echo -ne "\e[8;${LINES};${COLUMNS}t"
    source "$themerc" && _fzfmColors "${THEME}"
elif [[ -f $config && ! -f $themerc ]]; then
    source "$config"
    echo -ne "\e[8;${LINES};${COLUMNS}t"
    export FZF_DEFAULT_OPTS=""
else
    printf '%s\n' " ${red}$config: no such file or directory.${noc}"
    exit 127
fi

_usage() {
    tput clear
    echo
    cat <<- USAGE
    =========================================================================
    A TERMINAL BASED SIMPLE FILEMANAGER USING FZF WITH BASIC EXPECTED OPTIONS
    =========================================================================
    ${grn}${bold}If no option provided then $script_name uses $config${noblod}${noc}
    Press Ctrl-C or ESC to exit.

    Available options:
    -e <editor>       :Set your editor for editing files (default:vim).
    -f <program>      :Set a program to get infos from selected file (default:exiftool).
    -h|--help         :Print this message and exit.
    -i <image viewer> :Set a program to open image files (default:sxiv).
    -m <program>      :Set a program to get infos from selected media file (default:mediainfo).
    -p <player>       :Set a program to play selected media file (default:mpv).
    -t <theme>        :Use the selected theme from $config_dir/themerc

    Example:
    $script_name -e nano -i feh -f exiftool -m mediainfo -p vlc -t dark
USAGE
    exit 1
}

[[ $1 =~ -h|--help ]] && _usage

# Parsing command-line options
while getopts "e:f:i:m:p:t:" opt; do
    case $opt in
        e) FZFM_EDITOR="$OPTARG" ;;
        f) FILE_INFO="$OPTARG" ;;
        i) IMAGE_VIEWER="$OPTARG" ;;
        m) MEDIA_INFO="$OPTARG" ;;
        p) MEDIA_PLAYER="$OPTARG" ;;
        t) [[ -f $themerc ]] && THEME="$OPTARG" ;;
        *) _usage ;;
    esac
done

shift $(( OPTIND - 1 ))

# Ensure required tools and files are installed
declare -a deps=(
    bat df fzf stat tree ueberzugpp
    "$IMAGE_VIEWER" "$FILE_INFO"
    "$FZFM_EDITOR" "$MEDIA_INFO"
    "$ascii_file" "$book_marks" "$themerc"
)

for dep in "${deps[@]:0:10}"; do
    command -v "$dep" &> /dev/null || {
        echo "$dep is needed but not installed, exiting..."
        exit 127
    }
done

for dep in "${deps[@]:10:12}"; do
    [[ ! -f $dep ]] && {
        echo "${dep##*/} is needed but does not exist, exiting..."
        exit 127
    }
done

# We need to start a persistent ueberzugpp daemon
# to render image previews in the fzf preview pane
ueberzug_pid_file=$(mktemp -u /tmp/fzfm_ueberzug_XXXXXX.pid)
ueberzug_identifier="fzfm_preview"
ueberzugpp layer \
    --silent \
    --no-stdin \
    --pid-file "$ueberzug_pid_file" \
    -o "${UEBERZUG_OUTPUT:-x11}" &

# ueberzugpp getting ready, give it some time...
for _ in {1..20}; do
    [[ -s $ueberzug_pid_file ]] && break
    sleep 0.1
done

ueberzug_socket="/tmp/ueberzugpp-$(cat "$ueberzug_pid_file" 2> /dev/null).socket"
_ueberzugSend() {
    [[ -S $ueberzug_socket ]] && ueberzugpp cmd -s "$ueberzug_socket" "$@" &> /dev/null
}
# A good practice is to export functions used by fzf commands.
export -f _ueberzugSend

# stty only restores kernel tty driver modes (echo/icanon). Terminal emulators
# also track render state via escape codes (mouse reporting, bracketed paste,
# alt-screen, cursor visibility); an abruptly killed player can leave those
# enabled and stty alone won't undo them. Reset both, emulator-agnostic.
_resetTerminal() {
    stty sane 2> /dev/null
    printf '\e[?1000l\e[?1002l\e[?1003l\e[?1006l\e[?2004l\e[?1049l\e[?25h'
}

_ueberzugCleanup() {
    _ueberzugSend -a remove -i "$ueberzug_identifier"
    [[ -s $ueberzug_pid_file ]] && kill "$(cat "$ueberzug_pid_file")" &> /dev/null
    rm -f "$ueberzug_pid_file"
    _resetTerminal
}

trap _ueberzugCleanup EXIT

_mediaPlayer() {
    local media_file="$1"
    # Media player should run outside of the menu (detatched from the terminal),
    # so that we stay in the menu if we want to navigate around.
    __terminateMediaPlayer() {
        killall --quiet "$MEDIA_PLAYER"
        return 0
    }

    if [[ $MEDIA_PLAYER == 'mpv' ]] && (( ${#fzf_output[@]} > 1 )); then
        __terminateMediaPlayer && \
        printf '%s\n' "${fzf_output[@]}" | setsid -f mpv \
        --no-terminal "${mpvOptions[@]}" --playlist=- &> /dev/null
    elif [[ $MEDIA_PLAYER == 'mpv' ]]; then
        __terminateMediaPlayer && setsid -f \
        mpv --no-terminal "${mpvOptions[@]}" "$media_file" &> /dev/null
    else
        # Other media players may use the command line too...
        __terminateMediaPlayer && setsid -f \
        "$MEDIA_PLAYER" "$media_file" &> /dev/null
    fi
    tput clear
    _resetTerminal
}

declare -a dotdotadvice=(
    "YOU ARE IN THE HIGHEST DIRECTORY, HITTING '..' IS USELESS."
    "Hit enter on .. to go up a directotry (same as cd ..)"
)

source_file=""
# ctrl-w toggles this away from PREVIEW_POS;
# persists across navigation, resets on relaunch.
preview_flipped=false

# Main loop for navigation
while true; do

    : "${LINES:=36}"
    : "${COLUMNS:=130}"
    : "${PREVIEW_POS:=right}"
    : "${THEME:=default}"
    [[ $POINTER_SHAPE == 'default' ]] && POINTER_SHAPE="|>"

    source "$themerc" && _fzfmColors "${THEME}"

    if [[ $PREVIEW_POS == 'right' ]]; then
        active_preview_pos=$(
            [[ $preview_flipped == true ]] && echo left || echo right
        )
    else
        active_preview_pos=$(
            [[ $preview_flipped == true ]] && echo right || echo left
        )
    fi

    echo -ne "\e[8;${LINES};${COLUMNS}t"

    declare -a bookmarks=()
    while read -r line; do
        [[ ! $line =~ '#' ]] && bookmarks+=("${line}")
    done < "${book_marks}"

    export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS}
        --bind ctrl-a:toggle-all,ctrl-z:deselect
        --bind ctrl-b:accept,page-up:first,page-down:last,f12:accept
        --bind ctrl-d:accept,ctrl-e:accept,home:accept,ctrl-p:accept
        --bind ctrl-r:accept,ctrl-t:accept,ctrl-x:accept,ctrl-y:accept
        --bind ctrl-w:accept,right:accept,left:accept
        --border-label-pos=5:bottom
        --border=rounded
        --border-label='${cyn}[ ${bold}fzfm v_${version}${nobold} - Theme: ${THEME} ]${noc}'
        --color 'list-label:bold:red,input-label:bold:cyan,header-label:bold:yellow'
        --cycle
        --header-border=rounded
        --header-label ' selected file perms '
        --header-label-pos=top
        --info=inline-right
        --input-border=rounded
        --input-label ' filter box '
        --input-label-pos=top
        --height 100%
        --list-border=rounded
        --list-label-pos=top
        --multi
        --preview-window=${active_preview_pos}:67%
        --pointer='${POINTER_SHAPE}'
        --reverse
        --scroll-off=5
    "

    if [[ $(pwd) =~ ^\/$ ]]; then
        current_dir=${PWD}
    else
        current_dir=${PWD##*/}
    fi

    disk=$(df -h "$(pwd)" | awk 'NR==2 {print $3" / "$2}')
    # fzf preview: bat/ueberzugpp/exiftool/mediainfo for files, tree for directories
    selection=$(
        command ls -a --group-directories-first | grep -v '^.$' \
        | fzf --preview="
            ueberzugpp cmd -s '$ueberzug_socket' -a remove -i $ueberzug_identifier &> /dev/null
            if [[ $(pwd) == '/' && {} == '..' ]]; then
                echo -e ${red}'\n          ${dotdotadvice[0]}\n'${noc}
                head -29 $ascii_file
            elif [[ {} == '..' ]]; then
                echo -e ${ylw}'\n          ${dotdotadvice[1]}\n'${noc}
                head -29 $ascii_file
            elif [[ -d {} ]]; then
                tree -C {} | head -200
            elif [[ {} =~ ${IMAGE_EXTS}$ ]]; then
                ueberzugpp cmd -s '$ueberzug_socket' -a add -i $ueberzug_identifier \
                -x \"\$FZF_PREVIEW_LEFT\" -y \"\$FZF_PREVIEW_TOP\" \
                --max-width \"\$FZF_PREVIEW_COLUMNS\" --max-height \"\$FZF_PREVIEW_LINES\" \
                -f \"$(pwd)\"/{} &> /dev/null
            elif [[ {} =~ ${MEDIA_EXTS}$ ]]; then
                $MEDIA_INFO {}
            elif [[ {} =~ ${OTHER_EXTS}$ ]]; then
                $FILE_INFO {}
            else
                bat --wrap=never --color=always --style=numbers --line-range :500 {}
            fi" \
            --bind "focus:transform-header:stat -c %A {}" \
            --preview-label="${cyn}[ ${bold}disk: $disk${nobold} ]${noc}" \
            --expect=left,right,f12,ctrl-b,ctrl-d,ctrl-e,home,ctrl-p,ctrl-r,ctrl-t,ctrl-y,ctrl-x,ctrl-w \
            --list-label " Current dir: ${current_dir} "
    )

    # If nothing selected (ESC or Ctrl-C), exit the loop
    [[ -z $selection ]] && break

    # Clear any lingering image overlay before running prompts/cd/editor
    _ueberzugSend -a remove -i "$ueberzug_identifier"

    mapfile -t fzf_output <<< "$selection"
    key="${fzf_output[0]}"
    selection="${fzf_output[1]}"

    __dotsAreSelected() {
        [[ ${fzf_output[1]} == ".." ]] && {
            printf '\n%s\n' " ${red}'..' are selected, action cancelled.${noc}"
            sleep 2
            tput clear
            unset selected_items
            copy_buffer=()
        }
    }

    case $key in
        right|left) : ;;
        f12)
            # reload config and drop any ctrl-w flip,
            # so the new PREVIEW_POS takes effect immediately.
            "$FZFM_EDITOR" "$config" && {
                source "$config" && preview_flipped=false
                continue
            }
        ;;
        ctrl-b)
            selected_bookmark=$(
                printf '%s\n' "${bookmarks[@]}" | fzf \
                --prompt='' \
                --no-multi \
                --color 'list-label:bold:cyan' \
                --color 'preview-bg:#000000' \
                --list-label ' bookmarks ' \
                --preview-window="$active_preview_pos":60% \
                --preview="
                    printf '%s\n' ' Tips:' \
                    ' Bookmarks help you jump to frequently used directories quickly.'\
                    ' Add/remove bookmarks by editing ~/.config/fzfm/fzfm_bookmarks.' \
                    ' Press Enter to access the selected bookmark path.'
                "
            )
            selected_bookmark="${selected_bookmark/#~/$HOME}"
            [[ -z $selected_bookmark ]] && continue
            [[ -d $selected_bookmark ]] && cd "$selected_bookmark" || return 1
            continue
        ;;
        ctrl-d)
            tput clear
            # Getting all selected items except ctrl-d
            selected_items=("${fzf_output[@]:1}")
            # Avoiding dotdot to be removed
            __dotsAreSelected && continue
            printf '\n%s\n' " ${red}Selected item(s) to remove:${noc}"
            printf '%s\n' "${selected_items[@]}"
            read -r -p " ${red}Remove these ${#selected_items[@]} items? [y/N]: ${noc}" remove
            case $remove in
                [yY]|"")
                    rm -rf "${selected_items[@]}"
                    unset selected_items
                ;;
                *) unset selected_items ;;
            esac
            continue
        ;;
        ctrl-e)
            tput clear
            if [[ $selection =~ ${EDITOR_EXTS}$ || $OPEN_ANY == "true" ]]; then
                "$FZFM_EDITOR" "$selection"
            else
                printf '\n'
                read -r -p " ${red}Edit ${selection} with? ${noc}" alt_editor
                [[ ${alt_editor+x} ]] && "$alt_editor" "$selection"
            fi
            continue
        ;;
        home)
            [[ $selection != "/home/$USER" ]] && {
                cd /home/"$USER" || return 1
            }
            continue
        ;;
        ctrl-p)
            (( ${#copy_buffer[@]} == 0 )) && {
                tput clear
                echo -e "\n ${red}Nothing to paste. Use copy first.${noc}" >&2
                sleep 2
                continue
            }
            for source in "${copy_buffer[@]}"; do
                base=$(basename "$source")
                dest="$(pwd)/$base"
                if [[ $source == "$dest" ]]; then
                    cp -a -- "$source" "${dest}_"
                else
                    cp -a -- "$source" "$dest"
                fi
            done
            continue
        ;;
        ctrl-r)
            tput clear
            source_file="$selection"
            printf '\n'
            read -r -p " ${grn}Rename ${source_file##*/} to: ${noc}" new_name
            [[ -z ${new_name} ]] && {
                echo " ${red}${source_file##*/} has not been renamed.${noc}"
                sleep 2
                continue
            }
            mv -f -- "${source_file}" "${new_name}"
            continue
        ;;
        ctrl-t)
            __editNewFile() {
            read -rsn 1 -p " ${grn}Edit ${new_file}? [Y/n]: ${noc}" edit
            case "$edit" in
                [yY]|"")
                    [[ -f $new_dir/$new_file ]] && "$FZFM_EDITOR" "$new_dir/$new_file"
                    [[ ! -d $new_file ]] && "$FZFM_EDITOR" "$new_file"
                ;;
                [nN]) : ;;
                *)
                    printf '\n%s\n' " ${red}Wrong option $edit.${noc}"
                    sleep 2
                ;;
            esac
                unset IFS edit new_dir new_file
            }
            tput clear
            printf '\n'
            printf '%s\n' " ${grn}Use dir_name/ to create a directory," \
            " dir_name1/dir_name2/file_name for multiple subdirectories + one file," \
            " file_name1,file_name2 (comma separated) for multiple files."
            read -r -p " or simply: my_filename: ${noc}" new_file
            if [[ -z ${new_file} ]]; then
                echo " ${red}No dir_name or file_name provided...${noc}"
                sleep 2
            elif [[ $new_file =~ .+\/$ ]]; then
                new_dir="$new_file"
                mkdir -p "${new_dir}"
            elif [[ $new_file =~ .+\/+[[:alnum:]]+$ ]]; then
                new_dir=$(dirname "$new_file")
                new_file=$(basename "$new_file")
                mkdir -p "${new_dir}" && touch "$new_dir/$new_file"
                [[ -f $new_dir/$new_file ]] && __editNewFile
            elif [[ $new_file =~ ,+ ]]; then
                IFS=","; read -r -a new_files <<< "$new_file"
                for new_file in "${new_files[@]}"; do
                    touch "$new_file"
                done
                unset IFS new_file new_files
            elif [[ -f $new_file || -d $new_file ]]; then
                touch -- "${new_file}"_ && new_file="${new_file}"_
                __editNewFile
            else
                touch -- "${new_file}"
                __editNewFile
            fi
            continue
        ;;
        ctrl-w)
            [[ $preview_flipped == true ]] && \
            preview_flipped=false || preview_flipped=true
            continue
        ;;
        ctrl-x)
            __dotsAreSelected && continue
            tput clear
            selected_items=("${fzf_output[@]:1}")
            __movePrompts() {
                case $1 in
                    --multipleItems)
                        printf '\n%s\n' " ${grn}Selected items to move:${noc}"
                        printf '%s\n' "${selected_items[@]}"
                        read -r -p " ${grn}Move to (path): ${noc}" destination
                    ;;
                    --singleItem)
                        printf '\n'
                        read -r -p " ${grn}Move ${source_file##*/} to (path): ${noc}" destination
                    ;;
                    --error)
                        printf '%s\n' " ${red}No destination provided...${noc}"
                        sleep 3
                        continue
                    ;;
                esac
                destination="${destination/#~/$HOME}"
            }
            if (( ${#selected_items[@]} > 1 )); then
                __movePrompts --multipleItems
                [[ -z ${destination} ]] && __movePrompts --error
                for item in "${selected_items[@]}"; do
                    mv -f -- "$PWD/$item" "$destination/$(basename "$item")"
                done
            else
                source_file="$PWD/$selection"
                __movePrompts --singleItem
                [[ -z ${destination} ]] && __movePrompts --error
                mv -f -- "${source_file}" "$destination/$(basename "$source_file")"
            fi
            continue
        ;;
        ctrl-y)
            __dotsAreSelected && continue
            declare -a copy_buffer=()
            for item in "${fzf_output[@]:1}"; do
                copy_buffer+=("$PWD/$item")
            done
            continue
        ;;
        *) : ;;
    esac

    # Opening selected folder/file
    if [[ -d $selection ]]; then
        cd "$selection" || return 1
    elif [[ $selection =~ ${IMAGE_EXTS}$ ]]; then
        setsid -f "$IMAGE_VIEWER" "$selection" < /dev/null &> /dev/null
    elif [[ $selection =~ ${MEDIA_EXTS}$ || $selection =~ ${PLSTS_EXTS}$ ]]; then
        _mediaPlayer "$selection"
    elif [[ $selection =~ ${EDITOR_EXTS}$ || $OPEN_ANY == "true" ]]; then
        "$FZFM_EDITOR" "$selection"
    elif [[ $selection =~ ${OTHER_EXTS}$ || $OPEN_ANY == "true" ]]; then
        tput clear
        printf '\n'
        read -r -p " ${grn}Open $selection with?: " program
        case $program in
            deadbeef|ffplay|vlc)
                _mediaPlayer "$selection" & disown
            ;;
            mpv) _mediaPlayer "$selection" ;;
            *)
                { "$program" "$selection" & } || {
                    tput clear
                    echo -e "\n ${red}Unable to open $selection.${noc}"
                    sleep 2
                    continue
                }
            ;;
        esac
    else
    tput clear
        printf '\n'
        read -r -p " ${red}Edit ${selection}? [N/y]: ${noc}" edit
        [[ $edit =~ [yY] ]] && "$FZFM_EDITOR" "$selection"
        unset edit
    fi
    continue

done

unset current_dir
export FZF_DEFAULT_OPTS=
reset